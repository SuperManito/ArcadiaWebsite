{
  "name": "arcadia-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "build": "next build",
    "generate:openapi": "bun ./src/scripts/generate-docs.ts",
    "dev": "next dev",
    "info": "next info",
    "check": "fumadocs-mdx && next typegen && tsc --noEmit && rimraf tsconfig.tsbuildinfo",
    "postinstall": "fumadocs-mdx",
    "clean:cache": "rimraf .source && rimraf .next && rimraf node_modules/.cache/",
    "clean:build": "rimraf build && rimraf out && rimraf coverage",
    "clean:lock": "rimraf yarn.lock && rimraf pnpm-lock.yaml && rimraf package.lock.json",
    "clean:lib": "rimraf node_modules",
    "clean": "pnpm clean:build && pnpm clean:cache && pnpm clean:lock && pnpm clean:lib",
    "lint": "eslint",
    "lint:fix": "eslint --fix --ext .ts,tsx,js,jsx,mjs,mdx",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.147",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/language": "^0.2.15",
    "@iconify/react": "^6.0.2",
    "@next/third-parties": "^16.4.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@orama/orama": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-presence": "^1.1.11",
    "@takumi-rs/image-response": "^2.16.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.143",
    "antd": "^6.6.6",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.5.2",
    "fumadocs-ui": "16.17.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@next/bundle-analyzer": "^16.4.2",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": "eslint --fix"
  }
}
